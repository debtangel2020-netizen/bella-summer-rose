# Password Heleen uses to log in at /admin
ADMIN_PASSWORD=choose-a-long-password

# Any long random string (signs the admin login cookie)
SESSION_SECRET=paste-a-long-random-string-here

# Yoco secret key: Yoco app > Sales > Payment Gateway (starts with sk_live_ or sk_test_)
YOCO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# Filled in after you click "Connect Yoco payments" in Admin > Settings
YOCO_WEBHOOK_SECRET=

# Added automatically when you connect a Vercel Blob store to the project
# (newer stores add BLOB_STORE_ID instead of a token; either works)
BLOB_READ_WRITE_TOKEN=
